# Initial web login. On first start it is migrated to a PBKDF2 password hash.
# Later password changes are made from the Account menu in the web app.
BACKUP_REPORT_WEB_USERNAME=report
BACKUP_REPORT_WEB_PASSWORD=CHANGE_THIS_PASSWORD
BACKUP_REPORT_SESSION_HOURS=12
# Change to 1 only after the site is served through HTTPS.
BACKUP_REPORT_COOKIE_SECURE=0

BACKUP_REPORT_HOST=0.0.0.0
BACKUP_REPORT_PORT=8780
BACKUP_REPORT_NO_BROWSER=1
BACKUP_REPORT_ROOT=/opt/backup-report/app
BACKUP_REPORT_DATA_ROOT=/var/lib/backup-report/data
BACKUP_REPORT_REPORT_ROOT=/var/lib/backup-report/reports
BACKUP_REPORT_LOG_ROOT=/var/lib/backup-report/logs
BACKUP_REPORT_CAPTURE_ROOT=/var/lib/backup-report/captures
BACKUP_REPORT_CHROMIUM=/usr/bin/chromium-browser
BACKUP_REPORT_CHROMIUM_RUNTIME=/var/lib/backup-report/runtime

# Set these after running: fc-match -f '%{file}\n' 'Noto Sans Thai'
BACKUP_REPORT_FONT_REGULAR=/usr/share/fonts/google-noto/NotoSansThai-Regular.ttf
BACKUP_REPORT_FONT_BOLD=/usr/share/fonts/google-noto/NotoSansThai-Bold.ttf
