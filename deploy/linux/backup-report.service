[Unit]
Description=Synology Backup Report Web App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backup-report
Group=backup-report
WorkingDirectory=/opt/backup-report/app
EnvironmentFile=/etc/backup-report/backup-report.env
ExecStart=/opt/backup-report/venv/bin/python /opt/backup-report/app/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/backup-report
MemoryMax=512M
CPUQuota=50%
UMask=0027

[Install]
WantedBy=multi-user.target
